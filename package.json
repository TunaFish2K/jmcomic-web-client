{
  "name": "jm-web-client",
  "private": true,
  "scripts": {
    "page:dev": "pnpm --filter @tiny-client/page dev",
    "page:build": "pnpm --filter @tiny-client/page build",
    "worker:dev": "pnpm --filter @tiny-client/worker dev",
    "worker:deploy": "pnpm --filter @tiny-client/worker deploy",
    "dev": "concurrently \"pnpm run worker:dev\" \"wait-on tcp:localhost:8787 && VITE_BACKEND_URL=http://localhost:8787 pnpm run page:dev\""
  },
  "packageManager": "pnpm@10.28.0",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "wait-on": "^9.0.4"
  }
}
