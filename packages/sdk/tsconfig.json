{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "declaration": true, "sourceMap": true, "inlineSources": true, "outDir": "dist", "rootDir": "src",
    "esModuleInterop": true, "skipLibCheck": true, "noUncheckedIndexedAccess": true
  },
  "include": ["src/**/*.ts"]
}
