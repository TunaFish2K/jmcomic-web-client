{
    "name": "@tiny-client/page",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite --host",
        "build": "vite build && vitest run ./test/pwa-build.test.ts",
        "lint": "eslint .",
        "preview": "vite preview",
        "icons:generate": "node ./scripts/generate-icons.mjs",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage && node ./scripts/check-coverage.mjs",
        "test:album-cache": "vitest run ./test/album-cache.test.ts",
        "test:browser": "playwright test",
        "test:client": "tsx ./test/client.ts",
        "test:icons": "vitest run ./test/icon-assets.test.ts",
        "test:pwa": "vitest run ./test/pwa-update.test.ts",
        "test:reader": "vitest run ./test/reader-*.test.ts",
        "test:translation": "vitest run ./test/translation.test.ts",
        "test:theme": "vitest run ./test/theme.test.ts"
    },
    "dependencies": {
        "@heroui/react": "3.0.0-beta.6",
        "@heroui/styles": "3.0.0-beta.6",
        "@paddleocr/paddleocr-js": "^0.4.2",
        "@tanstack/react-query": "^5.90.21",
        "@tiny-client/shared": "workspace:*",
        "crypto-js": "^4.2.0",
        "embla-carousel-react": "^8.6.0",
        "framer-motion": "^12.34.0",
        "lucide-react": "^0.564.0",
        "onnxruntime-web": "1.27.0",
        "p-limit": "^7.3.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-router-dom": "^7.13.0",
        "set-cookie-parser": "^3.0.1",
        "tailwind-merge": "^3.4.0",
        "tailwind-variants": "^3.2.2"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@playwright/test": "^1.62.1",
        "@tailwindcss/vite": "^4.1.18",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.6",
        "@types/crypto-js": "^4.2.2",
        "@types/node": "^24.10.1",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "@types/set-cookie-parser": "^2.4.10",
        "@vitest/coverage-v8": "4.1.11",
        "@vitejs/plugin-react": "^5.1.1",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint": "^9.39.1",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.4.24",
        "fake-indexeddb": "^6.2.5",
        "globals": "^16.5.0",
        "jsdom": "^26.1.0",
        "prettier": "^3.8.1",
        "sharp": "^0.34.5",
        "tailwindcss": "^4.0.0",
        "tsx": "^4.21.0",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.48.0",
        "vite": "^8.0.1",
        "vite-plugin-pwa": "^1.2.0",
        "vitest": "4.1.11"
    }
